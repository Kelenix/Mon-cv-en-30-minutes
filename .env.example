# Copier ce fichier en `.env.local` (jamais versionné) puis renseigner les valeurs.
# Chaque incrément ajoute ici les variables dont il a besoin (docs/architecture.md §5).

# Adresse publique du site, sans barre finale (URLs absolues : métadonnées, retours de paiement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Inc-2). En local : valeurs affichées par `npm run db:status` (API_URL,
# PUBLISHABLE_KEY, SECRET_KEY). La clé secrète contourne la RLS : serveur uniquement.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Bouton « Continuer avec Google » : à passer à true une fois Google activé dans Supabase
# (tâche manuelle 5).
GOOGLE_AUTH_ENABLED=false

# Publicités (Inc-11, tâche manuelle 10) : off (aucune), simulation (annonces de test sans
# script externe : développement et tests) ou google (Ad Manager et bandeau de consentement
# « Confidentialité et messages » de Google, identifiants ci-dessous obligatoires).
ADS_MODE=off
# Identifiant d'éditeur Google (pub-…) et code réseau Ad Manager.
ADS_PUBLISHER_ID=
ADS_NETWORK_CODE=
# Vend le retrait définitif des publicités (2,99 €) sur Tarifs et dans les crédits.
ADS_REMOVAL_ENABLED=false

# IA (Inc-4, tâche manuelle 3). Sans clé, l'IA est SIMULÉE : le CV reprend les réponses telles
# quelles (développement et tests). Clé obligatoire en production.
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut : claude-opus-5-5, ADR-006).
ANTHROPIC_MODEL=claude-opus-5-5

# Sel secret du hachage des adresses IP (plafond de 3 CV gratuits par IP et par jour, H27).
# 32 caractères minimum, ex. `openssl rand -hex 32`. Facultatif en local (plafond non appliqué),
# obligatoire en production.
IP_HASH_SALT=

# Stripe (Inc-6, tâche manuelle 4) : clé secrète de TEST (sk_test_…) en développement, puis
# `npm run stripe:seed` pour créer produits, prix et portail. Secret des webhooks : affiché par
# `docker compose run --rm stripe listen --print-secret`. Sans ces clés, le paiement est
# indisponible ; obligatoires en production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails envoyés par le site (avertissement avant suppression d'un compte inactif, US-40).
# Sans SMTP_HOST, les e-mails sont seulement journalisés (développement et tests).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Mon CV en 30 Secondes

# Protection contre les robots à la connexion (Cloudflare Turnstile, tâche manuelle 16). Sans ces
# clés, la vérification est désactivée (développement et tests) ; obligatoires en production.
# Clés de test de Cloudflare : site 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA (toujours accepté).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Jeton des tâches planifiées (`/api/cron/retention`), 32 caractères minimum.
CRON_SECRET=

# Informations du vendeur affichées dans les pages légales (tâche manuelle 7).
# Facultatives en local ; OBLIGATOIRES en production (APP_ENV=production, fixé par
# deploy/docker-compose.yml) : le site refuse de démarrer si l'une d'elles manque, sauf
# LEGAL_VAT_NUMBER. En production, toutes les variables sont dans deploy/.env (docs/deployment.md).
LEGAL_COMPANY_NAME=
# Forme juridique et capital, ex. « SAS au capital de 1 000 € »
LEGAL_FORM=
# Immatriculation, ex. « RCS Paris 123 456 789 » ou « SIRET 123 456 789 00012 »
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
# Adresse e-mail de contact (réclamations, droits RGPD, rétractation)
LEGAL_EMAIL=
# Directeur ou directrice de la publication
LEGAL_PUBLISHER=
# Numéro de TVA intracommunautaire, si vous en avez un
LEGAL_VAT_NUMBER=
# Hébergeur du site : nom, adresse et téléphone
LEGAL_HOSTING=
# Médiateur de la consommation : nom et site web
LEGAL_MEDIATOR=
