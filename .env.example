# Copier ce fichier en `.env.local` (jamais versionné) puis renseigner les valeurs.
# Chaque incrément ajoute ici les variables dont il a besoin (docs/architecture.md §5).

# Adresse publique du site, sans barre finale (URLs absolues : métadonnées, retours de paiement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Inc-2). En local : valeurs affichées par `npm run db:status` (API_URL,
# PUBLISHABLE_KEY, SECRET_KEY). La clé secrète contourne la RLS : serveur uniquement.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Bouton « Continuer avec Google » : à passer à true une fois Google activé dans Supabase
# (tâche manuelle 5).
GOOGLE_AUTH_ENABLED=false

# Affiche l'offre « Suppression des publicités » (2,99 €) sur la page Tarifs. Laisser à false
# tant que les publicités ne sont pas en place (Inc-11).
ADS_REMOVAL_ENABLED=false

# Informations du vendeur affichées dans les pages légales (tâche manuelle 7).
# Facultatives en local ; OBLIGATOIRES en production (VERCEL_ENV=production) : le build échoue
# si l'une d'elles manque, sauf LEGAL_VAT_NUMBER.
LEGAL_COMPANY_NAME=
# Forme juridique et capital, ex. « SAS au capital de 1 000 € »
LEGAL_FORM=
# Immatriculation, ex. « RCS Paris 123 456 789 » ou « SIRET 123 456 789 00012 »
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
# Adresse e-mail de contact (réclamations, droits RGPD, rétractation)
LEGAL_EMAIL=
# Directeur ou directrice de la publication
LEGAL_PUBLISHER=
# Numéro de TVA intracommunautaire, si vous en avez un
LEGAL_VAT_NUMBER=
# Hébergeur du site : nom, adresse et téléphone
LEGAL_HOSTING=
# Médiateur de la consommation : nom et site web
LEGAL_MEDIATOR=
