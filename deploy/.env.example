# Configuration de production du VPS (docs/deployment.md). Copier en `deploy/.env` sur le
# serveur (jamais versionné, droits 600), puis lancer `deploy/scripts/generate-secrets.sh` qui
# remplit les secrets techniques. Une valeur contenant le caractère $ s'écrit entre apostrophes.

# --- Domaine --------------------------------------------------------------------------------
# Domaine du site, sans https:// ni barre finale (ADR-043).
DOMAIN=cv30secondes.com
# Sous-domaine de l'API Supabase (api.DOMAIN : certificat obtenu par setup-vps.sh, ADR-044).
SUPABASE_DOMAIN=api.cv30secondes.com

# --- Secrets techniques (générés par deploy/scripts/generate-secrets.sh) --------------------
POSTGRES_PASSWORD=
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=
CRON_SECRET=

# --- E-mails par Resend (tâche manuelle 6) : connexion et avertissements avant suppression -----
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Clé d'API Resend (re_…), droit « Sending access » limité au domaine du site.
SMTP_PASSWORD=
# Adresse d'expédition sur le domaine vérifié chez Resend.
SMTP_SENDER_EMAIL=no-reply@cv30secondes.com
SMTP_SENDER_NAME=Mon CV en 30 Secondes
# E-mails de connexion par heure au plus. Offre gratuite de Resend : 100 e-mails par jour en
# tout (mettre 10) ; offre Pro : 200 convient.
AUTH_EMAILS_PER_HOUR=200

# --- Administration (/admin) : adresses e-mail des administrateurs, séparées par des virgules
ADMIN_EMAILS=

# --- Protection contre les robots à la connexion (tâche manuelle 16) : Cloudflare Turnstile -----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Connexion Google (tâche manuelle 5) -------------------------------------------------------
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- IA (tâche manuelle 3) ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Paiements Stripe (tâche manuelle 4), clés du mode réel ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Publicités (tâche manuelle 10) : off, simulation ou google --------------------------------
ADS_MODE=off
ADS_PUBLISHER_ID=
ADS_NETWORK_CODE=
ADS_REMOVAL_ENABLED=false

# --- Informations du vendeur (tâche manuelle 7), toutes obligatoires sauf la TVA -------------
LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PUBLISHER=
LEGAL_VAT_NUMBER=
# Hébergeur : nom, adresse et téléphone de Hostinger (voir docs/deployment.md).
LEGAL_HOSTING=
LEGAL_MEDIATOR=
